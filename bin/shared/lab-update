#!/usr/bin/env bash
# shellcheck disable=SC2016
set -Eeuo pipefail
IFS=$'\n\t'
(( BASH_VERSINFO[0] >= 5 )) || { echo 'lab-update: Bash 5 is required' >&2; exit 1; }
die() { echo "lab-update: $*" >&2; exit 1; }
usage() { echo "usage: $0 [--dry-run] hades" >&2; }
DRY_RUN=0
[[ ${1:-} != --dry-run ]] || { DRY_RUN=1; shift; }
[[ $# == 1 ]] || { usage; exit 64; }
HOST=$1; [[ $HOST == hades ]] || die "unsupported host: $HOST"
: "${LAB_UPDATE_TARGET:?run lab-update through the packaged flake app}"
: "${LAB_UPDATE_SSH_USER:?run lab-update through the packaged flake app}"
: "${LAB_UPDATE_IDENTITY:?run lab-update through the packaged flake app}"
: "${LAB_UPDATE_PROXY_JUMP:?run lab-update through the packaged flake app}"
TARGET=$LAB_UPDATE_TARGET
SSH_USER=$LAB_UPDATE_SSH_USER
IDENTITY=$LAB_UPDATE_IDENTITY
PROXY_JUMP=$LAB_UPDATE_PROXY_JUMP
[[ $TARGET =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*$ && $SSH_USER =~ ^[a-z_][a-z0-9_-]*$ ]] || die 'invalid packaged SSH route'
[[ $IDENTITY == - || $IDENTITY =~ ^\.ssh/[a-zA-Z0-9._-]+$ ]] || die 'invalid packaged identity file'
[[ $PROXY_JUMP == - || $PROXY_JUMP =~ ^[a-zA-Z0-9][a-zA-Z0-9.-]*$ ]] || die 'invalid packaged proxy jump'
SSH=(ssh -o BatchMode=yes -o ControlMaster=no -o ControlPath=none -o ConnectTimeout=10 -o ServerAliveInterval=5 -o ServerAliveCountMax=3)
[[ $IDENTITY == - ]] || SSH+=(-o IdentitiesOnly=yes -i "$HOME/$IDENTITY")
[[ $PROXY_JUMP == - ]] || SSH+=(-o "ProxyJump=$PROXY_JUMP")
ENDPOINT="$SSH_USER@$TARGET"
phases=("snapshot tracked source" "unprivileged remote preflight" "confirm staging" "unprivileged private staging" "unprivileged target-local build" "unprivileged closure inspection" "confirm activation" "one attended PTY sudo rollout" "unprivileged bounded rollout observation" "optional attended reboot")
if (( DRY_RUN )); then
  echo 'DRY RUN: no SSH or network calls will be made'; printf 'host: %s\ntransport: %s\n' "$HOST" "$ENDPOINT"; printf 'phase: %s\n' "${phases[@]}"; exit
fi
for c in ssh tar shasum jj; do command -v "$c" >/dev/null || die "$c is required"; done
T=$(mktemp -d "${TMPDIR:-/tmp}/lab-update.XXXXXX"); trap 'rm -rf "$T"' EXIT
ROOT=$(jj root) || die 'not in a jj workspace'; cd "$ROOT"
jj file list -T 'path ++ "\0"' | LC_ALL=C sort -z >"$T/list"
[[ -s $T/list ]] || die 'empty source manifest'
if tar --version 2>/dev/null | grep -q 'GNU tar'; then
  tar --format=ustar --owner=0 --group=0 --numeric-owner --mtime='UTC 1970-01-01' --sort=name --no-recursion -cf "$T/source.tar" --null -T "$T/list"
else
  COPYFILE_DISABLE=1 tar --no-xattrs --no-acls --no-fflags -cf "$T/source.tar" --null -T "$T/list"
fi
cat >"$T/driver" <<'DRIVER'
#!/run/current-system/sw/bin/bash
set -Eeuo pipefail
(( BASH_VERSINFO[0] >= 5 )) || { echo 'rollout driver: Bash 5 is required' >&2; exit 69; }
SYS=$(/run/current-system/sw/bin/readlink -f /run/current-system)
[[ ${PATH-} == "$SYS/sw/bin" ]] || { echo 'rollout driver: pinned PATH drift' >&2; exit 70; }
export PATH="$SYS/sw/bin" HOME=/root LC_ALL=C
B="$SYS/sw/bin"
closure=$1 baseline=${2-}
[[ $baseline != __LAB_UPDATE_EMPTY__ ]] || baseline=
[[ $closure =~ ^/nix/store/[a-z0-9]{32}-[A-Za-z0-9._+=-]+$ ]] || exit 64
old=$($B/readlink -f /nix/var/nix/profiles/system)
armed=0 mutated=0 success=0
finish() {
  rc=$? profile_rc=0 boot_rc=0
  trap - EXIT TERM INT HUP
  if (( ! success && mutated )); then
    $B/timeout 60 $B/nix-env -p /nix/var/nix/profiles/system --set "$old" || profile_rc=$?
    $B/timeout 120 "$old/bin/switch-to-configuration" boot || boot_rc=$?
    printf 'rollback profile=%s boot=%s; dead-man remains armed\n' "$profile_rc" "$boot_rc" >&2
    rc=71
  elif (( ! success && armed )); then
    echo 'rollout failed before profile mutation; no rollback required, dead-man remains armed' >&2
  elif (( ! success )); then
    echo 'rollout failed before dead-man was armed; no rollback required' >&2
  fi
  $B/rm -f -- /run/lab-update-driver
  exit "$rc"
}
trap finish EXIT
trap 'exit 143' TERM HUP
trap 'exit 130' INT
manifest_link="$closure/etc/lab-update/required-units"
manifest=$($B/readlink -f -- "$manifest_link") || exit 65
[[ $manifest =~ ^/nix/store/[a-z0-9]{32}-[A-Za-z0-9._+=-]+(/[^/]+)*$ && -f $manifest && -r $manifest ]] || exit 65
units=()
while IFS= read -r u || [[ -n $u ]]; do
  [[ -n $u && $u =~ ^[A-Za-z0-9@_.:-]+\.service$ ]] || exit 65
  units+=("$u")
done < "$manifest"
(( ${#units[@]} > 0 )) || exit 65
$B/systemctl stop lab-update-inhibit.service 2>/dev/null || true
$B/systemctl reset-failed lab-update-inhibit.service 2>/dev/null || true
$B/systemd-run --unit=lab-update-inhibit --collect "$B/systemd-inhibit" --what=sleep --why=lab-update --mode=block "$B/sleep" 1200
$B/shutdown -r +15 'lab-update dead-man reboot'; armed=1
"$closure/bin/switch-to-configuration" test
[[ $($B/readlink -f /run/current-system) == "$closure" ]]
now=$({ $B/systemctl --failed --no-legend --plain || true; } | $B/awk '{print $1}' | $B/sort | $B/paste -sd, -)
[[ $now == "$baseline" ]]
$B/getent ahosts cache.nixos.org >/dev/null
$B/findmnt / >/dev/null
if $B/grep -Eq '[[:space:]]/boot[[:space:]]' "$closure/etc/fstab"; then $B/findmnt /boot >/dev/null; fi
for u in "${units[@]}"; do
  $B/systemctl is-active --quiet "$u"
done
for u in sleep.target suspend.target hibernate.target hybrid-sleep.target; do [[ $($B/systemctl is-enabled "$u" 2>/dev/null) == masked ]]; done
$B/shutdown -r +15 'lab-update commit dead-man reboot'
mutated=1
$B/nix-env -p /nix/var/nix/profiles/system --set "$closure"
"$closure/bin/switch-to-configuration" boot
[[ $($B/readlink -f /nix/var/nix/profiles/system) == "$closure" ]]
[[ $($B/readlink -f /run/current-system) == "$closure" ]]
success=1
if ! $B/shutdown -c; then echo 'rollout committed, but dead-man cancellation failed; reboot remains armed' >&2; exit 72; fi
$B/systemctl stop lab-update-inhibit.service || true
DRIVER
chmod 700 "$T/driver"
DRIVER_SHA=$(shasum -a 256 "$T/driver" | cut -d ' ' -f 1)
[[ $DRIVER_SHA =~ ^[0-9a-f]{64}$ ]] || die 'invalid driver SHA-256'

# Every data-bearing and observational connection is non-PTY and unprivileged.
PRE=$("${SSH[@]}" "$ENDPOINT" 'bash -s' <<'REMOTE'
set -Eeuo pipefail
[[ $(uname -s) == Linux && -e /etc/NIXOS ]]
u=$(id -un); id -nG "$u" | tr ' ' '\n' | grep -qx wheel
status=$(passwd -S "$u"); set -- $status; [[ ${2:-} == P ]]
current=$(readlink -f /run/current-system); booted=$(readlink -f /run/booted-system); profile=$(readlink -f /nix/var/nix/profiles/system)
[[ $current == "$booted" && $current == "$profile" ]]
[[ $booted =~ ^/nix/store/[a-z0-9]{32}-[A-Za-z0-9._+=-]+$ ]]
B=$booted/sw/bin
for c in bash readlink rm timeout nix-env systemctl systemd-run systemd-inhibit sleep shutdown awk sort paste getent findmnt grep; do [[ -x $B/$c ]] || { echo "missing driver binary: $B/$c" >&2; exit 68; }; done
major=$($B/bash -c 'printf %s "$BASH_VERSINFO"'); (( major >= 5 ))
printf 'CURRENT=%s\nBOOTED=%s\nPROFILE=%s\nBASH_MAJOR=%s\n' "$current" "$booted" "$profile" "$major"
printf 'FAILED='; { systemctl --failed --no-legend --plain || true; } | awk '{print $1}' | LC_ALL=C sort | paste -sd, -
REMOTE
) || die 'preflight failed (wheel membership and a real password are required)'
printf '%s\n' "$PRE"; BASE_FAILED=$(sed -n 's/^FAILED=//p' <<<"$PRE"); BOOTED=$(sed -n 's/^BOOTED=//p' <<<"$PRE")
[[ $BASE_FAILED =~ ^[A-Za-z0-9@_.:,~-]*$ ]] || die 'unsafe failed-unit baseline'
[[ $BOOTED =~ ^/nix/store/[a-z0-9]{32}-[A-Za-z0-9._+=-]+$ ]] || die 'unsafe booted system path'
read -r -p "Type 'update $HOST' to stage and build: " a; [[ $a == "update $HOST" ]] || die 'not confirmed'
REMOTE_DIR=$("${SSH[@]}" "$ENDPOINT" 'umask 077; d=$(mktemp -d /var/tmp/lab-update.XXXXXXXX); printf "%s\n" "$d"')
[[ $REMOTE_DIR =~ ^/var/tmp/lab-update\.[A-Za-z0-9]{8}$ ]] || die 'unsafe staging path'
cleanup() { "${SSH[@]}" "$ENDPOINT" "rm -rf -- $REMOTE_DIR" >/dev/null 2>&1 || true; rm -rf "$T"; }
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP
"${SSH[@]}" "$ENDPOINT" "tar --no-same-owner -xf - -C $REMOTE_DIR" <"$T/source.tar"
"${SSH[@]}" "$ENDPOINT" "cat >$REMOTE_DIR/rollout-driver && chmod 0700 $REMOTE_DIR/rollout-driver" <"$T/driver"
REMOTE_SHA=$("${SSH[@]}" "$ENDPOINT" "sha256sum $REMOTE_DIR/rollout-driver" | awk '{print $1}')
[[ $REMOTE_SHA == "$DRIVER_SHA" ]] || die 'staged driver hash mismatch'
BUILD=$("${SSH[@]}" "$ENDPOINT" "nix build --no-link --no-write-lock-file --print-out-paths --builders '' $REMOTE_DIR#nixosConfigurations.$HOST.config.system.build.toplevel") || die 'build failed'
mapfile -t paths < <(grep '^/nix/store/' <<<"$BUILD"); [[ ${#paths[@]} == 1 ]] || die 'expected one closure'; CLOSURE=${paths[0]}
[[ $CLOSURE =~ ^/nix/store/[a-z0-9]{32}-[A-Za-z0-9._+=-]+$ ]] || die 'unsafe closure path'
"${SSH[@]}" "$ENDPOINT" "nix path-info $CLOSURE >/dev/null && test -x $CLOSURE/bin/switch-to-configuration && test -x $CLOSURE/sw/bin/sshd && nix store diff-closures \$(readlink -f /run/current-system) $CLOSURE && test -r $CLOSURE/etc/ssh/sshd_config && test -r $CLOSURE/etc/fstab && test -r $CLOSURE/etc/lab-update/required-units && grep -Fqx sshd.service $CLOSURE/etc/lab-update/required-units && grep -Fqx tailscaled.service $CLOSURE/etc/lab-update/required-units && grep -Fqx NetworkManager.service $CLOSURE/etc/lab-update/required-units && findmnt --verify --tab-file $CLOSURE/etc/fstab && awk '\$2==\"/\"{ok=1} END{exit !ok}' $CLOSURE/etc/fstab && ! findmnt -nro OPTIONS /boot 2>/dev/null | grep -Eq '(^|,)ro(,|$)'" || die 'closure inspection failed (check required files and units, fstab root entry, and /boot mount options)'
read -r -p "Type 'activate $HOST' to start the rollback-protected rollout: " a; [[ $a == "activate $HOST" ]] || die 'activation not confirmed'
[[ -t 0 ]] || die 'the attended privileged phase requires a local stdin TTY'
# Exactly one data-free attended connection. sudo reads the password directly from its TTY.
# Encode empty distinctly so argv[2] is present through both remote-shell layers.
if [[ -z $BASE_FAILED ]]; then qbase=__LAB_UPDATE_EMPTY__; else printf -v qbase '%q' "$BASE_FAILED"; fi
PTY_CMD="sudo /bin/sh -ceu 'test \"\$(sha256sum $REMOTE_DIR/rollout-driver | cut -d \" \" -f 1)\" = $DRIVER_SHA; $CLOSURE/sw/bin/sshd -t -f $CLOSURE/etc/ssh/sshd_config; systemctl stop lab-update-rollout.service 2>/dev/null || true; systemctl reset-failed lab-update-rollout.service 2>/dev/null || true; install -o root -g root -m 0500 $REMOTE_DIR/rollout-driver /run/lab-update-driver; test \"\$(stat -c %U:%G:%a /run/lab-update-driver)\" = root:root:500; test \"\$(sha256sum /run/lab-update-driver | cut -d \" \" -f 1)\" = $DRIVER_SHA; systemd-run --unit=lab-update-rollout --property=RemainAfterExit=yes --property=RuntimeMaxSec=600 --property=TimeoutStopSec=210 --setenv=PATH=$BOOTED/sw/bin --setenv=HOME=/root --setenv=LC_ALL=C --no-block /run/lab-update-driver $CLOSURE $qbase'"
"${SSH[@]}" -tt "$ENDPOINT" "$PTY_CMD" || die 'rollout launch failed; an armed reboot may remain pending (rollback is not guaranteed)'
# 780s leaves a two-minute margin before the 900s dead-man while covering RuntimeMaxSec plus rollback.
deadline=$((SECONDS+780)); observed=0
while (( SECONDS < deadline )); do
  out=$("${SSH[@]}" "$ENDPOINT" "timeout 25 sh -c 'systemctl show lab-update-rollout.service -p LoadState -p ActiveState -p SubState -p Result -p ExecMainStatus; printf \"CURRENT=%s\\nPROFILE=%s\\n\" \"\$(readlink -f /run/current-system)\" \"\$(readlink -f /nix/var/nix/profiles/system)\"'" 2>/dev/null) || { sleep 5; continue; }
  declare -A state=(); complete=1
  while IFS='=' read -r key value; do case $key in LoadState|ActiveState|SubState|Result|ExecMainStatus|CURRENT|PROFILE) state[$key]=$value;; esac; done <<<"$out"
  for key in LoadState ActiveState SubState Result ExecMainStatus CURRENT PROFILE; do [[ -v state[$key] ]] || complete=0; done
  (( complete )) || { sleep 5; continue; }
  load=${state[LoadState]}; active=${state[ActiveState]}; sub=${state[SubState]}; result=${state[Result]}; status=${state[ExecMainStatus]}; current=${state[CURRENT]}; profile=${state[PROFILE]}
  [[ $load == loaded ]] || die 'rollout unit is unknown or collected; dead-man may remain armed'
  if [[ $status == 64 ]]; then die 'rollout rejected an unsafe closure before reboot was armed'; fi
  if [[ $status == 65 ]]; then die 'rollout rejected an invalid required-unit manifest before reboot was armed'; fi
  if [[ $status == 69 || $status == 70 ]]; then die 'rollout interpreter/environment failed before reboot was armed'; fi
  [[ $status != 72 ]] || die 'new closure is active, but dead-man cancellation failed; reboot remains armed'
  [[ $status != 71 ]] || die 'rollout failed after mutation and rollback was attempted; dead-man remains armed'
  if [[ $active == failed || $result == failed || ( $status =~ ^[0-9]+$ && $status != 0 ) ]]; then die 'rollout failed; dead-man may remain armed'; fi
  if [[ $active == active && $sub == exited && $result == success && $status == 0 ]]; then
    [[ $current == "$CLOSURE" && $profile == "$CLOSURE" ]] || die 'rollout terminal state has wrong closure/profile; dead-man may remain armed'
    observed=1; echo "rollout succeeded: $CLOSURE"; break
  fi
  sleep 5
done
(( observed )) || die 'rollout observation timed out; dead-man may remain armed'
read -r -p "Type 'reboot $HOST' for an attended reboot, or Enter to finish: " a
if [[ $a == "reboot $HOST" ]]; then "${SSH[@]}" -tt "$ENDPOINT" 'sudo systemctl reboot' || echo 'reboot requested; SSH disconnected during reboot' >&2; fi
