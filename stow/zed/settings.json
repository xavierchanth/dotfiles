{
  "outline_panel": {
    "dock": "right",
  },
  "collaboration_panel": {
    "dock": "right",
  },
  "git_panel": {
    "dock": "right",
  },
  "close_panel_on_toggle": true,
  "languages": {
    "Nix": {
      "enable_language_server": false,
    },
  },
  "icon_theme": {
    "mode": "system",
    "light": "JetBrains Icons Light",
    "dark": "JetBrains Icons Dark",
  },
  "tab_size": 2,
  "cli_default_open_behavior": "existing_window",
  "ui_font_size": 14.0,
  "buffer_font_size": 14.0,
  "context_servers": {
    "mcp-server-brave-search": {
      "enabled": true,
      "remote": false,
      "settings": {},
    },
  },
  "vim": {
    "toggle_relative_line_numbers": false,
  },
  "relative_line_numbers": "enabled",
  "diff_view_style": "unified",
  "use_auto_surround": false,
  "use_autoclose": false,
  "ui_font_family": "Helvetica Neue",
  "edit_predictions": {
    "disabled_globs": [],
    "provider": "zed",
    "mode": "subtle",
  },
  "show_edit_predictions": true,

  "command_aliases": {
    "w": "workspace::Save",
    "W": "workspace::SaveWithoutFormat",
    "wa": "workspace::SaveAll",
  },
  "use_system_window_tabs": true,
  "debugger": {
    "button": true,
  },
  "terminal": {
    "toolbar": {
      "breadcrumbs": true,
    },
    "button": true,
    "env": {
      "EDITOR": "zed -w",
      "VISUAL": "zed -w",
    },
  },
  "project_panel": {
    "dock": "right",
    "button": true,
  },
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "effort": "low",
        "model": "opencode/big-pickle"
      },
      "favorite_config_option_values": {
        "model": [
          "openai/gpt-5.6-sol",
          "openai/gpt-5.6-luna",
          "opencode/claude-fable-5",
          "cloudflare-ai-gateway/anthropic/claude-fable-5",
          "cloudflare-ai-gateway/moonshotai/kimi-k3"
        ]
      },
      "type": "registry"
    },
    "codex-acp-rs": {
      "type": "custom",
      "command": "/Users/chant/.cargo/bin/codex-acp",
      "args": [],
      "env": {
        "CODEX_PATH": "/Users/chant/.bun/install/global/node_modules/@openai/codex-darwin-arm64/vendor/aarch64-apple-darwin/bin/codex",
      },
    },
    "codex-acp": {
      "default_config_options": {
        "fast-mode": "off",
        "reasoning_effort": "high",
        "model": "gpt-5.6-sol",
      },
      "type": "registry",
    },
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": true,
    "show_tab_bar_buttons": true,
    "show_nav_history_buttons": false,
  },
  "git": {
    "blame": {
      "show_avatar": true,
    },
  },
  "proxy": "",
  "agent": {
    "thread_summary_model": {
      "provider": "openai-subscribed",
      "model": "gpt-5.6-luna",
      "enable_thinking": false,
    },
    "flexible": true,
    "sidebar_side": "left",
    "dock": "left",
    "expand_edit_card": true,
    "favorite_models": [],
    "model_parameters": [],
  },
  "calls": {
    "mute_on_join": true,
  },
  "tabs": {
    "file_icons": false,
    "close_position": "left",
    "git_status": false,
  },
  "title_bar": {
    "show_user_menu": true,
    "show_menus": false,
    "show_onboarding_banner": false,
    "show_project_items": true,
    "show_user_picture": true,
    "show_sign_in": false,
    "show_branch_name": false,
    "show_branch_status_icon": false,
  },
  "status_bar": {
    "cursor_position_button": true,
    "show_active_file": true,
  },
  "seed_search_query_from_cursor": "never",
  "search": {
    "button": true,
    "regex": true,
  },
  "diagnostics": {
    "button": true,
    "inline": {
      "enabled": true,
    },
  },
  "prettier": {
    "allowed": true,
  },

  "document_symbols": "on",
  "document_folding_ranges": "on",
  "semantic_tokens": "combined",
  "vim_mode": true,
  "theme": {
    "mode": "system",
    "light": "Github Plus Light",
    "dark": "One Dark",
  },
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "restore_on_startup": "launchpad",
  "redact_private_values": false,
  "on_last_window_closed": "quit_app",
  "when_closing_with_no_tabs": "close_window",
  "buffer_font_family": "CommitMono Nerd Font Mono",
  "wrap_guides": [80, 120],
}
