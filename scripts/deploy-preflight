#!/usr/bin/env bash
set -Eeuo pipefail
[[ $# == 1 && $1 =~ ^[a-z_][a-z0-9_-]*$ ]] || { echo 'deploy: invalid Home Manager recipient' >&2; exit 1; }
# Sent over SSH stdin before staging credentials or starting a mutating rollout.
# This observes existing work; it is not a lock between simultaneous clients.
processes=$(ps -eo uid=,pid=,ppid=,stat=,etime=,args=) || {
  echo 'deploy: cannot inspect target activation processes' >&2; exit 1;
}
busy=$(printf '%s\n' "$processes" | awk '
  $1 == 0 {
    for (i = 6; i <= NF; i++) {
      if ($i ~ /(^|\/)(switch-to-configuration|deploy-rs-activate|nixos-rebuild|activate-rs)$/ ||
          $i ~ /^\/nix\/store\/[^\/]*deploy-rs[^\/]*\/bin\/activate$/) {
        print; break
      }
    }
  }
')
unit="home-manager-$1.service"
state=$(systemctl show "$unit" --no-pager -p LoadState -p ActiveState -p SubState -p MainPID -p ControlPID) || {
  echo "deploy: cannot inspect $unit" >&2; exit 1;
}
unit_busy=0
while IFS='=' read -r key value; do
  case $key in
    ActiveState) case $value in activating|deactivating|reloading) unit_busy=1;; esac;;
    MainPID|ControlPID) [[ $value =~ ^[0-9]+$ ]] || { echo "deploy: invalid $key for $unit" >&2; exit 1; }; [[ $value == 0 ]] || unit_busy=1;;
  esac
done <<<"$state"
if [[ -n $busy || $unit_busy == 1 ]]; then
  echo 'deploy: target has an activation in progress; refusing overlapping deployment' >&2
  if [[ -n $busy ]]; then
    echo 'UID PID PPID STATE ELAPSED COMMAND' >&2
    printf '%s\n' "$busy" >&2
  fi
  if [[ $unit_busy == 1 ]]; then printf '%s\n%s\n' "$unit:" "$state" >&2; fi
  echo 'deploy: inspect these processes and Home Manager logs, then wait for completion or recover the interrupted rollout before retrying' >&2
  exit 1
fi
