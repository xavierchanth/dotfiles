#!/usr/bin/env bash
set +x
set -euo pipefail

# Authenticate before Nix fetches any flake inputs. Never persist the token.
if ! jio_gh_token=$(gh auth token --hostname github.com 2>/dev/null); then
  echo "GitHub authentication unavailable; sign in with gh auth login first." >&2
  exit 1
fi
case "$jio_gh_token" in
  ''|*[!a-zA-Z0-9_]*) echo "GitHub CLI returned an invalid token." >&2; exit 1 ;;
esac
if ! jio_existing_tokens=$(nix config show access-tokens 2>/dev/null); then
  echo "Unable to read Nix authentication configuration." >&2
  exit 1
fi
jio_merged_tokens=""
if [[ -n "$jio_existing_tokens" ]]; then
read -r -a jio_token_entries <<< "$jio_existing_tokens"
for jio_entry in "${jio_token_entries[@]}"; do
  case "$jio_entry" in
    github.com=*) ;;
    *) jio_merged_tokens+="$jio_entry " ;;
  esac
done
fi
export NIX_CONFIG="${NIX_CONFIG-}
access-tokens = ${jio_merged_tokens}github.com=${jio_gh_token}"
unset jio_gh_token jio_existing_tokens jio_merged_tokens jio_token_entries jio_entry
exec nix "$@"
